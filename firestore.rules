rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'listratenkoelena1@gmail.com';
    }

    match /{document=**} {
      allow read, write: if isOwner();
    }
  }
}
